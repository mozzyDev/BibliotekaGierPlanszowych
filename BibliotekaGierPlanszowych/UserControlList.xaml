<UserControl x:Class="BibliotekaGierPlanszowych.UserControlList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BibliotekaGierPlanszowych"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <Grid >
        <materialDesign:TransitioningContent x:Name="TrainsitionigContentSlide">
            <Grid VerticalAlignment="center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 2 0 0">
                    <Button  Background="#05b790" Foreground="#ffffff"  Width="140" Height="50" Margin="0 5 5 5" Click="ButtonAddBGG_Click" IsDefault="False">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                            <materialDesign:PackIcon  Kind="PlusBoxOutline" Margin="10" Height="20" Width="20"/>
                            <TextBlock Margin="0 10 0 0">Dodaj z BGG</TextBlock>
                        </StackPanel>

                    </Button>
                    <Button  Background="#05b790" Foreground="#ffffff"  Width="100" Height="50" Margin="0 5 5 5" Click="ButtonAdd_Click" IsDefault="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            
                            <materialDesign:PackIcon  Kind="PlusBox" Margin="10" Height="20" Width="20"/>
                            <TextBlock Margin="0 10 0 0">Dodaj</TextBlock>
                        </StackPanel>
                       
                    </Button>
                    <Button  Background="#05b790" Foreground="#ffffff"  Width="144" Height="50" Margin="0 5 5 5" Click="ButtonGetCollection_Click" IsDefault="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                            <materialDesign:PackIcon  Kind="LibraryBooks" Margin="10" Height="20" Width="20"/>
                            <TextBlock Margin="0 10 0 0">Kolekcja BGG</TextBlock>
                        </StackPanel>

                    </Button>

                    <Button  Background="#05b790" Foreground="#ffffff" x:Name="ListEdit_btn" IsEnabled="False" Width="120" Height="50" Margin="0 5 5 5" Click="ListEdit_btn_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                            <materialDesign:PackIcon  Kind="TableEdit" Margin="10" Height="20" Width="20"/>
                            <TextBlock Margin="0 10 0 0">Pokaż grę</TextBlock>
                        </StackPanel>

                    </Button>
                    <Button  Background="#05b790" Foreground="#ffffff"  x:Name="ListDelete_btn" IsEnabled="False" Width="100" Height="50" Margin="0 5 5 5" Click="DeleteButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                            <materialDesign:PackIcon  Kind="Delete" Margin="10" Height="20" Width="20"/>
                            <TextBlock Margin="0 10 0 0">Usuń</TextBlock>
                        </StackPanel>

                    </Button>
                    <Button  Background="#05b790" Foreground="#ffffff"  x:Name="ListDeleteAll_btn" IsEnabled="True" Width="160" Height="50" Margin="0 5 0 5" Click="DeleteAllButton_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Width="135">

                            <materialDesign:PackIcon  Kind="Delete" Margin="10" Height="20" Width="20"/>
                            <TextBlock Margin="0 10 0 0">Usuń wszystkie</TextBlock>
                        </StackPanel>

                    </Button>

                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0 10 0 0" Orientation="Vertical">
                    <!-- Pole wyszukiwania -->
                    <Grid Margin="0 0 0 10" HorizontalAlignment="Center">
                        <TextBox x:Name="SearchTextBox" 
                                 Width="500" 
                                 Height="44" 
                                 FontSize="16" 
                                 Padding="10,5"
                                 materialDesign:HintAssist.Hint="Szukaj gry po tytule..."
                                 TextChanged="SearchTextBox_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="#05b790" 
                                                        BorderThickness="2" 
                                                        CornerRadius="5">
                                                    <Grid>
                                                        <ScrollViewer x:Name="PART_ContentHost" 
                                                                      Margin="{TemplateBinding Padding}"/>
                                                        <materialDesign:PackIcon Kind="Magnify" 
                                                                                 Width="20" 
                                                                                 Height="20" 
                                                                                 VerticalAlignment="Center" 
                                                                                 HorizontalAlignment="Right" 
                                                                                 Margin="0,0,10,0" 
                                                                                 Foreground="Gray"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <DataGrid x:Name="List_DataGrid" Background="#FFEEEEEE"  FontSize="16" Cursor="Hand" Height="480" Width="1020" Panel.ZIndex="-3" SelectionChanged="List_DataGrid_SelectionChanged_1" MouseDoubleClick="List_DataGrid_MouseDoubleClick" HorizontalAlignment="Stretch"  >
                        <DataGrid.Effect>
                            <DropShadowEffect BlurRadius="10"/>
                        </DataGrid.Effect>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </materialDesign:TransitioningContent>
    </Grid>
</UserControl>
