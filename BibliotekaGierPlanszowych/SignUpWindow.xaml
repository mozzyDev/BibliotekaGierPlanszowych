<Window x:Class="BibliotekaGierPlanszowych.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:BibliotekaGierPlanszowych"
        mc:Ignorable="d"
        Title="SignUpWindow" Height="644" Width="800"
        WindowStartupLocation = "CenterScreen"
        WindowStyle ="None" 
        AllowsTransparency ="True" 
        Background="Transparent"
        ResizeMode="NoResize"
        FontSize="18"
        FontFamily="{DynamicResource MaterialDesignFont}"
        >
    <Window.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="30"
                              ShadowDepth="1"
                              Opacity="0.4">
            </DropShadowEffect>
        </Grid.Effect>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.22*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#07bf96"
                CornerRadius="10 0 0 10"
                ClipToBounds="True">

            <Border.Clip>
                <RectangleGeometry Rect="0,0,400,605"
                                       RadiusX="10"
                                       RadiusY="10">

                </RectangleGeometry>
            </Border.Clip>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="267*"/>
                    <RowDefinition Height="344*"/>
                </Grid.RowDefinitions>
                <!--Ellipses-->
                <Ellipse Width="500"
                     Height="500"
                     VerticalAlignment="Bottom"
                     Fill="#5eccb4"
                     Margin="50,0,-208,-200"
                     Opacity="0.6" Grid.Row="1"/>

                <Ellipse Width="300"
                     Height="300"
                     VerticalAlignment="Bottom"
                     Fill="#5bcbb3"
                     Margin="-204,0,246,30"
                     Opacity="0.3" Grid.Row="1"/>

                <Ellipse Width="250"
                     Height="250"
                     VerticalAlignment="Bottom"
                     Fill="#5bc9b2"
                     Margin="-104,0,196,-120" Grid.Row="1"/>

                <Ellipse Width="400"
                     Height="400"
                     VerticalAlignment="Bottom"
                     Fill="#5eccb4"
                     Margin="280,0,-338,-70"
                     Opacity="0.8" Grid.Row="1"/>

                <StackPanel Margin="0 150 0 0" VerticalAlignment="Top">
                    <TextBlock FontSize="46"
                           FontWeight="Light"
                           Text="Logowanie"
                           Foreground="#ffffff"
                           TextAlignment="Center"
                           />
                </StackPanel>

                <!--Titles-->
                <!--Icon-->
                <Border Background="#fdfdfd"
                        CornerRadius="100"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Height="110"
                        Width="110"
                        Margin="116,0,116,80" Grid.Row="1">
                    <Grid>
                        <!--Icon-->
                        <materialDesign:PackIcon Kind="Check"
                                                 Width="70"
                                                 Height="70"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                        </materialDesign:PackIcon>
                        <!--ColloredEllipses-->
                        <Ellipse Width="100"
                                 Height="100"
                                 StrokeThickness="4">
                            <Ellipse.Stroke>
                                <LinearGradientBrush>
                                    <GradientStop Color="#e27c53"
                                                  Offset="0.15"/>

                                    <GradientStop Color="#dca530"
                                                  Offset="0.2"/>

                                    <GradientStop Color="#8bb799"
                                                  Offset="0.3"/>

                                    <GradientStop Color="#3bb799"
                                                  Offset="0.4"/>

                                    <GradientStop Color="#67cbee"
                                                  Offset="0.5"/>

                                    <GradientStop Color="#3699db"
                                                  Offset="0.6"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                    </Grid>
                </Border>

            </Grid>
        </Border>
        <!--RightSection-->
        <Border Grid.Column="1"
                        Background="#ffffff"
                        CornerRadius="0 10 10 0"
                        MouseDown="Grid_MouseDown">
            <Grid>
                <Button x:Name="ButtonExit" Width="40" Height="40" Padding="0" Margin="370
                        -550 10 0" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="Gray" Click="ButtonExit_Click" >
                    <materialDesign:PackIcon Kind="Power" Width="35" Height="35"/>
                </Button>
                <Button x:Name="ButtonMin" Width="40" Height="40" Padding="0" Margin="300
                        -535 10 0"  Background="{x:Null}" BorderBrush="{x:Null}" Foreground="Gray" Click="ButtonMin_Click" >
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="35" Height="35"/>
                </Button>
                <StackPanel VerticalAlignment="Center"
                                    Margin="75 0">

                    <TextBox x:Name="TextBox_Login" Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Text="Login"
                                     materialDesign:HintAssist.Hint="Login"
                                     materialDesign:HintAssist.FloatingOffset="0,-18"
                                     BorderBrush="#c5c8cc"
                                     BorderThickness="0 0 0 1.5"/>
                    <PasswordBox x:Name="TextBox_Pass" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                     Password="123456"
                                     materialDesign:HintAssist.Hint="Hasło"
                                     materialDesign:HintAssist.FloatingOffset="0,-18"
                                     BorderBrush="#c5c8cc"
                                     BorderThickness="0 0 0 1.5"
                                     Margin=" 0 10"/>
                    <PasswordBox x:Name="TextBox_RepPass" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                                     Password="123456"
                                     materialDesign:HintAssist.Hint="Powtórz hasło"
                                     materialDesign:HintAssist.FloatingOffset="0,-18"
                                     BorderBrush="#c5c8cc"
                                     BorderThickness="0 0 0 1.5"
                                     Margin=" 0 10"
                                     Visibility="{Binding IsChecked, ElementName=CheckBox_Register, Converter={StaticResource BoolToVisConverter}}"/>

                    <CheckBox x:Name="CheckBox_Register" Margin="5 60 0 30"
                                      FontSize="13">
                        <TextBlock>
                                    <Run Foreground="#b6b6b6"/>Rejestracja
                        </TextBlock>
                    </CheckBox>


                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="Button_Register" Content="Rejestracja"
                                        Background="#05b790"
                                        Foreground="#ffffff"
                                        FontSize="12"
                                        Width="100"
                                        Height="35" Click="Button_Register_Click"
                                        Visibility="{Binding IsChecked, ElementName=CheckBox_Register, Converter={StaticResource BoolToVisConverter}}"
                                        />
                        <Button x:Name="Button_Login" Content="Logowanie"
                                        FontSize="12"
                                        Width="100"
                                        Height="35"
                                        Margin="5 0 0 0 "
                                        Background="#05b790"
                                        Foreground="#ffffff"
                                        Click="Button_Login_Click"
 
                                />
                    </StackPanel>
                </StackPanel>
            </Grid>

        </Border>
    </Grid>
</Window>
